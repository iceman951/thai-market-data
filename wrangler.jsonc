{
  "name": "thai-market-data",
  "main": "build/index.js",
  "compatibility_date": "2026-09-23",
  "build": {
    "command": "worker-build --release"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thai-market-eod",
      // Replace with the existing database ID before any remote command.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      // Create this bucket or replace the name with your existing raw bucket.
      "bucket_name": "thai-market-eod-raw"
    }
  ],
  // Add a reviewed UTC cron expression when a collection schedule is chosen.
  "triggers": { "crons": [] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
